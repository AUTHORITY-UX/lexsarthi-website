{
  "info": {
    "name": "Unknown Verdict v40.0 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Production Legal AI Platform - 36 API Endpoints powered by Sarvam AI.\n\nAuthentication:\n- JWT Bearer: Authorization: Bearer <token>\n- API Key: X-API-Key: <your-api-key>\n\nDefault admin: admin@unknownverdict.ai / admin123"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:7860"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@unknownverdict.ai\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Test User\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/refresh",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"<your-refresh-token>\"\n}"
            }
          }
        },
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/api-keys",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My API Key\",\n  \"scopes\": [\n    \"chat\",\n    \"legal\"\n  ]\n}"
            }
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/api-keys"
          }
        }
      ]
    },
