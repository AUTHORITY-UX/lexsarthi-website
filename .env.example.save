# Replace actual API keys with placeholders like:
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Unknown Verdict v41.0 - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Configuration
# ============================================
APP_NAME=Unknown Verdict v41.0
APP_VERSION=41.0
DEBUG=false
ENVIRONMENT=production
PORT=7860

# ============================================
# Security
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Database (Neon PostgreSQL with pgvector)
# ============================================
DATABASE_URL=postgresql://username:password@hostname.neon.tech/database?sslmode=require

# Example Neon connection string:
# DATABASE_URL=postgresql://user:pass@ep-xyz.neon.tech/dbname?sslmode=require

# ============================================
# Redis (for rate limiting & caching)
# ============================================
REDIS_URL=redis://localhost:6379/0

# For production Redis with auth:
# REDIS_URL=redis://:password@redis-host:6379/0

# For Upstash Redis (HF Spaces):
# REDIS_URL=rediss://:password@hostname.redis.cloud/0

# ============================================
# Sarvam AI (Primary LLM)
# ============================================
SARVAM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL_105B=sarvam-105b
SARVAM_MODEL_30B=sarvam-30b

# ============================================
# OpenAI (Fallback/Alternative)
# ============================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================
# Google Gemini
# ============================================
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-pro

# ============================================
# Groq (Fast inference)
# ============================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-70b-8192

# ============================================
# DeepSeek
# ============================================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# OpenRouter (Aggregator)
# ============================================
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# ============================================
# Moat Configuration (Self-Evolution)
# ============================================
MOAT_ENABLED=true
MOAT_UPDATE_INTERVAL=3600  # seconds between evolution cycles
MOAT_AUTO_LEARN=true
MOAT_MAX_HISTORY=1000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100  # requests per period
RATE_LIMIT_PERIOD=60     # period in seconds

# ============================================
# Feature Flags
# ============================================
ENABLE_STREAMING=true
ENABLE_CACHING=true
ENABLE_AUTH=true
ENABLE_VERIFIERS=true
ENABLE_AI_JUDGE=true

# ============================================
# JSON Configuration (for Pydantic)
# ============================================
# These should be valid JSON arrays
TARGETED_SEARCH_DOMAINS=["https://www.indiacode.nic.in", "https://www.sci.gov.in", "https://legalaffairs.gov.in", "https://www.indiacode.nic.in/rss", "https://www.livelaw.in/rss"]

ALLOWED_ORIGINS=["https://upamnyu12-lex.hf.space", "http://localhost:7860", "https://*.hf.space"]

# ============================================
# Document Processing
# ============================================
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.rtf

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# ============================================
# Monitoring (Prometheus)
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================
# Payment (Razorpay)
# ============================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxx

# ============================================
# Email (for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@unknownverdict.com

# ============================================
# HF Space Specific
# ============================================
HF_SPACE=true
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx
SPACE_ID=upamnyu12/LEX
SPACE_HOST=https://upamnyu12-lex.hf.space

# ============================================
# Production Optimizations
# ============================================
WORKERS=2
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
GRACEFUL_TIMEOUT=30
TIMEOUT_KEEP_ALIVE=5

# ============================================
# LLM Fallback Chain (ordered list)
# ============================================
LLM_FALLBACK_CHAIN=sarvam,openai,gemini,groq,deepseek,openrouter

# ============================================
# Feature-Specific
# ============================================
LEGAL_RESEARCH_ENABLED=true
RAG_ENABLED=true
VECTOR_DIMENSION=1536
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With
